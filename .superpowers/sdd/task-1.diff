-    .export-row { flex-direction: column; gap: 6px; }
-    .export-row .btn { width: 100%; min-height: 44px; }
-
-    /* Benchmark row */
-    .benchmark-row { flex-direction: column; align-items: flex-start; gap: 8px; }
-
-    /* Tables */
-    .table { font-size: 0.75rem; }
-    .table th { padding: 8px 10px; position: sticky; top: 0; z-index: 2; }
-    .table td { padding: 8px 10px; }
-    .table-wrap { max-height: 300px; overflow-y: auto; -webkit-overflow-scrolling: touch; }
-
-    /* Buttons */
-    .btn { min-height: 44px; font-size: 0.9375rem; }
-    .btn--sm { min-height: 36px; font-size: 0.8125rem; }
-    .btn-row { flex-direction: column; gap: 6px; }
-
-    /* Strategy picker */
-    .strategy-picker { max-height: 160px; }
-
-    /* Footer */
-    .footer {
-        padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
-    }
-
-    /* Detail card */
-    .detail-card { padding: 10px 12px; }
-    .detail-row { font-size: 0.8125rem; padding: 5px 0; }
-
-    /* Chips */
-    .chips { gap: 6px; }
-    .chip { padding: 4px 10px; font-size: 0.75rem; }
-
-    /* Config row */
-    .config-row { flex-direction: column; gap: 6px; }
-
-    /* Autocomplete full width */
-    .autocomplete { max-height: 240px; }
-
-    /* Radio rows */
-    .radio-row { gap: 12px; }
-    .radio-label { font-size: 0.8125rem; }
-
-    /* Sub cards */
-    .sub-card { padding: 12px 0; }
-    .sub-card__desc { font-size: 0.6875rem; }
-
-    /* Onboarding */
-    .onboarding__card { padding: 24px; width: 92%; }
-    .onboarding__title { font-size: 1.125rem; }
-    .onboarding__desc { font-size: 0.875rem; }
-}
-
-/* === MOBILE FAB === */
-.fab {
-    display: none;
-    position: fixed;
-    bottom: calc(24px + env(safe-area-inset-bottom, 0px));
-    right: 20px;
-    width: 56px; height: 56px;
-    border-radius: 16px;
-    border: none;
-    background: var(--primary);
-    color: var(--on-primary);
-    box-shadow: var(--elevation-2);
-    cursor: pointer;
-    z-index: 500;
-    align-items: center; justify-content: center;
-    transition: all 200ms var(--ease);
-    animation: fabIn 200ms var(--ease);
-}
-.fab:active { transform: scale(0.92); }
-.fab .material-symbols-rounded { font-size: 28px; }
-.fab.hidden { display: none !important; }
-@keyframes fabIn { from { opacity: 0; transform: scale(0.8) translateY(12px); } }
-@media (max-width: 767px) {
-    .fab { display: flex; }
-}
-
-/* === MOBILE: 1-column metrics on tiny screens === */
-@media (max-width: 400px) {
-    .metrics { grid-template-columns: 1fr; }
-    .presets { grid-template-columns: 1fr; }
-}
-
-/* === MOBILE: Tooltip tap-to-toggle state === */
-.tooltip--visible {
-    display: block !important;
-    opacity: 1 !important;
-    transform: translate(-50%, -50%) !important;
-}
-.tooltip-backdrop {
-    display: none;
-    position: fixed; inset: 0; z-index: 9998;
-}
-.tooltip-backdrop.active { display: block; }
